# MongoDB Connection String (Replace with your actual string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/BMLibrary?retryWrites=true&w=majority

# Secret Key for JWT (Change this to a long, random string)
JWT_SECRET=your_very_secure_secret_key_12345

# Stripe Keys (For future payment integration)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...